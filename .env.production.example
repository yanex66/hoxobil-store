# Django Core Settings
DEBUG=False
SECRET_KEY=your-secure-random-key-here

# Database (Required for production)
# Example PostgreSQL: postgres://user:password@host:5432/dbname
DATABASE_URL=

# Deployment Host
RENDER_EXTERNAL_HOSTNAME=your-domain.com

# CORS & Security
CORS_ALLOWED_ORIGINS=https://hoxobil.store,https://www.hoxobil.store

# Email Configuration (Required for production emails)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True

# Payment Gateways - Replace with your PRODUCTION keys
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-xxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_SECRET_KEY=FLWSECK-xxxxxxxxxxxxxxxxxxxxx-X

PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxx
PAYSTACK_MODE=live

# Print-on-Demand Providers
PRINTFUL_ACCESS_TOKEN=your-printful-token
PRINTFUL_STORE_ID=your-store-id

# AI & External APIs
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx
SERPER_API_KEY=your-serper-api-key

# Base URL for frontend
PUBLIC_BASE_URL=https://hoxobil.store
